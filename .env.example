# Option A: Docker PostgreSQL (default from docker-compose.yml)
# Option B: Use your existing PostgreSQL/Supabase URL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nexus_dev
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nexus_test

# Authentication Secrets
# Run `openssl rand -hex 32` to generate a secure key
SECRET_KEY=dev_secret_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
# Set to 'production' to enforce Secure=True on cookies
ENVIRONMENT=development
