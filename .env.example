# ── Database ────────────────────────────────────────────────────────────────
# Option A: Docker PostgreSQL (default from docker-compose.yml)
# Option B: Replace with your Supabase / managed PostgreSQL URL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nexus_dev
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nexus_test

# ── Authentication ──────────────────────────────────────────────────────────
# REQUIRED in production: generate with `openssl rand -hex 32`
# The string below is the development placeholder — it is REJECTED in ENVIRONMENT=production.
SECRET_KEY=dev_secret_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Environment ─────────────────────────────────────────────────────────────
# Set to 'production' to enable secure cookies, strict secret validation,
# and to require a real email provider.
ENVIRONMENT=development

# ── GitHub (optional) ───────────────────────────────────────────────────────
# Unauthenticated GitHub API calls are limited to 60/hour.
# Add a personal access token to raise the limit to 5000/hour.
# GITHUB_TOKEN=ghp_your_token_here

# ── Application base URL ────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000

# ── Email provider ──────────────────────────────────────────────────────────
# EMAIL_PROVIDER options:
#   stub      (default) -- Development only. Prints reset URL to stdout.
#                          REJECTED in ENVIRONMENT=production.
#   sendgrid            -- SendGrid v3 API. Requires EMAIL_API_KEY.
#   smtp                -- Generic SMTP. Requires SMTP_HOST/USERNAME/PASSWORD.
EMAIL_PROVIDER=stub
EMAIL_FROM=noreply@your-domain.com

# SendGrid (required when EMAIL_PROVIDER=sendgrid)
# EMAIL_API_KEY=SG.your_sendgrid_api_key_here

# SMTP relay (required when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_USE_TLS=true
