# ==============================================================================
# NEXUS Environment Configuration Template
# ==============================================================================

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-nexus-secret-key-32-chars-min
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://nexus:nexus_password@localhost:5432/nexus_db
DATABASE_SYNC_URL=postgresql://nexus:nexus_password@localhost:5432/nexus_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis (Caching & Task Queue)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Supported providers: gemini, ollama, huggingface, openai
DEFAULT_LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_DEFAULT=gemini-1.5-pro
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Ollama (Local LLM execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=llama3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Hugging Face
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Observability & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# Storage (Local / S3 / GCS)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
