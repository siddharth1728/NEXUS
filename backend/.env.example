# NEXUS Environment Configuration Example

# App Settings
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///nexus.db
DATABASE_SYNC_URL=sqlite:///nexus.db

# Security Settings
APP_SECRET_KEY=nexus-insecure-dev-secret-key-change-in-production-32chars

# Redis Settings
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# AI Provider Settings
DEFAULT_LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_DEFAULT=gemini-1.5-pro
GEMINI_MODEL_FAST=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=llama3:8b
HUGGINGFACE_API_TOKEN=your_hf_api_token_here
